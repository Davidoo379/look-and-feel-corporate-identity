---
title: Profile
layout: "base.njk"
tags:
layoutCard: colleague-image
name: Jane Joe
role: Doctor
salutation: Dr.
intentions: ["Open to new collaboration in general"]
meshTerms: ["Adolescent Health", "Contraception", "Clinical Decision-Making"]
image:
institute: Red Cross Hospital
specialism: Pediatrics
subSpecialism: Gynecology
location:
time:
organizer:
attendees:
quote: I'm unterested in research that bridges te clinical care and social inequality
experience: 7 years
biography: Lorem ipsum dolor sit amet consectetur adipisicing elit. Possimus esse excepturi quis debitis voluptatibus, dolor natus eveniet tenetur deleniti ipsum ducimus ratione suscipit magnam asperiores! Quibusdam maiores iste reprehenderit sed?
colorPreference: "pink"

---
<main class="profile">
  <section id="about-user" class="about-user tab-section">
    <div class="sticky-top">
      <a href="#edit" class="button-raised">
        edit
        {% include "svgs/write.njk" %}
      </a>
    </div>
    <div class="detail-block-quote">
      <blockquote class="{{ colorPreference }}">
        {{ quote }}
      </blockquote>
    </div>
    <dl class="info-section">
      <dt>Username:</dt>
      <dd>{{ salutation }} {{ name }}</dd>
      <dt>Role:</dt>
      <dd>{{ role }}</dd>
      <dt>Specialism (sub-specialism):</dt>
      <dd>{{ subSpecialism }}</dd>
      <dt>Years of experience:</dt>
      <dd>{{ experience }}</dd>
      <dt>Institution:</dt>
      <dd>{{ institute }}</dd>
      <div class="colleague-ids">
        <a href="linkedin.com">
          {% include "svgs/linkedin.njk" %}
        </a>
        <button
          class="align-horizontal button-raised"
          popovertarget="identifiers"
        >
          {% include "svgs/id-card.njk" %}
          Identifiers
        </button>
        <div popover id="identifiers">
          <p><em>ORCID:</em> {{ orcid }}</p>
          <p><em>BIG registration:</em> {{ big-registration }}</p>
        </div>
      </div>
    </dl>
    <div class="biography">
      <h3>Biography</h3>
      <p>
        {{ biography }}
      </p>
      <h3>Mesh terms</h3>
      <ul class="mesh-terms">
        {%- for meshTerm in meshTerms -%}
          <li>{{ meshTerm }}</li>
        {%- endfor -%}
      </ul>
      <h3>Intentions</h3>
      <ul class="mesh-terms">
        {%- for intention in intentions -%}
          <li>{{ intention }}</li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
  <section id="edit" class="edit tab-section">
    <div class="sticky-top">
      <a href="#about-user" class="button-raised">
        save
        {% include "svgs/write.njk" %}
      </a>
    </div>
    <form name="edit-profile" action="/">
      <fieldset>
        <legend>Display quote and/or photo</legend>
        <label for="quote">User quote</label>
        <textarea name="quote" id="quote">{{ quote }}</textarea>
        <div class="text-area-footer">
          <fieldset>
            <legend>Color preference:</legend>
            <label for="green-preference">Green</label>
            <input type="radio" name="color-preference" id="green-preference">
            <label for="blue-preference">Blue</label>
            <input type="radio" name="color-preference" id="blue-preference">
            <label for="pink-preference">Pink</label>
          </fieldset>
          <input type="radio" name="color-preference" id="pink-preference">
          <p class="word-count">0/300</p>
        </div>
        <label for="image-upload">
          <span>Image upload</span>
          {% include "svgs/person-circle.njk" %}
          <input
            type="file"
            name="image-upload"
            id="image-upload"
            accept="image/png, image/jpeg"
          >
        </label>
        <fieldset>
          <legend>Display choose:</legend>
          <label class="button-raised">
            <span>image</span>
            {% include "svgs/image.njk" %}
            <input type="checkbox">
          </label>
          <label class="button-raised">
            <span>quote</span>
            {% include "svgs/text.njk" %}
            <input type="checkbox">
          </label>
        </fieldset>
      </fieldset>
      <fieldset>
        <legend>User information</legend>
        <label class="divider">
          <span>Username:</span>
          <input
            name="username"
            type="text"
            value="{{ name }}"
            placeholder="type your username"
            autocomplete="{{ name }}"
          >
        </label>
        <label>
          <span>Specialism:</span>
          <select name="specialism">
            <option value="{{ specialism | kabab}}">
              {{ specialism }}
            </option>
            <option value="anesthesiology">Anesthesiology</option>
            <option value="bioinformatics">Bioinformatics</option>
            <option value="cardiology">Cardiology</option>
            <option value="surgery">Surgery</option>
            <option value="dermatology">Dermatology</option>
            <option value="epidemiology">Epidemiology</option>
            <option value="pharmacology">Pharmacology</option>
            <option value="urology">Urology</option>
          </select>
        </label>
        <label class="divider">
          <span>(sub-Specialism):</span>
          <input
            name="sub-specialism"
            type="text"
            placeholder="type more context if needed"
            value="{{ subSpecialism }}"
          >
        </label>
        <label class="divider">
          <span>Institute:</span>
          <select name="institute">
            <option value="{{ institute | kabab}}">
              {{ institute }}
            </option>
            <option value="albert-scheitzer-hospital">
              Albert Scheitzer Hospital
            </option>
            <option value="amphia-hospital">Amphia Hospital</option>
            <option value="beatrix-childrenshospital-umcg">
              Beatrix Childrenshospital / UMCG
            </option>
            <option value="catharina-hospital">Catharina Hospital</option>
          </select>
        </label>
        <label>
          <span>Years of experience</span>
          <input
            type="text"
            name="years-of-experience"
            value="{{ experience }}"
          >
        </label>
        <label class="divider">
          <span>Role:</span>
          <select name="role">
            <option value="{{ role | kabab}}">
              {{ role }}
            </option>
            <option value="medicla-researcher">Medical researcher</option>
            <option value="fundamental-researcher">
              Fundamental researcher
            </option>
            <option value="analyst">
              Analyst
            </option>
            <option value="student">
              Student
            </option>
            <option value="catharina-hospital">Catharina Hospital</option>
          </select>
        </label>
        <label>
          <span>Linkd-IN</span>
          <input
            type="text"
            name="years-of-experience"
            placeholder="paste link here"
          >
        </label>
      </fieldset>
      <fieldset>
        <legend>About me</legend>
        <label for="about-me">About me</label>
        <textarea
          name="about-me"
          id="about-me"
          placeholder="Describe your background, focus and interests"
        >
            {{ biography }}
        </textarea>
        <div class="text-area-footer">
          <p class="word-count">0/1000</p>
        </div>
        <menu class="align-horizontal">
          <li>
            <button title="bold" class="button-raised">
              {% include "svgs/bold.njk" %}
            </button>
          </li>
          <li>
            <button title="italic" class="button-raised">
              {% include "svgs/italic.njk" %}
            </button>
          </li>
          <li>
            <button title="unordered-list" class="button-raised">
              {% include "svgs/dot-list.njk" %}
            </button>
          </li>
          <li>
            <button title="ordered-list.njk" class="button-raised">
              {% include "svgs/number-list.njk" %}
            </button>
          </li>
          <li>
            <button title="link" class="button-raised">
              {% include "svgs/link.njk" %}
            </button>
          </li>
          <li>
            <button title="attachment" class="button-raised">
              {% include "svgs/paperclip.njk" %}
            </button>
          </li>
          <li>
            <button title="image" class="button-raised">
              {% include "svgs/image.njk" %}
            </button>
          </li>
          <li>
            <button title="video" class="button-raised">
              {% include "svgs/video.njk" %}
            </button>
          </li>
        </menu>
      </fieldset>
      <fieldset>
        <legend>MeSH terms</legend>
        <p>Select terms that best capture the focus of your work.</p>
        <div>
          <select name="mesh-term">
            <option value="data-interpretation">
              Data Interpretation
            </option>
            <option value="clinical-decision-making">
              Cinical Decision-Making
            </option>
          </select>
          <button class="button-raised button-circle" title="add-meshterm">
            {% include "svgs/plus-thin.njk" %}
          </button>
        </div>
        <ul class="mesh-terms">
          {% for item in meshTerms %}
            <li>
              <span>
                {{ item }}
              </span>
              <button class="button-plain" title="discard-meshterm">
                {% include "svgs/x.njk" %}
              </button>
            </li>
          {% endfor %}
        </ul>
      </fieldset>
      <fieldset>
        <legend>My intentions</legend>
        <p>
          Select intentions that best capture what you wish to achieve on this
          platform.
        </p>
        <div>
          <select name="mesh-term">
            <option value="open-to-new-collaboration in-general">
              Open to new collaboration in general
            </option>
            <option value="open-to-questions">
              Open to questions
            </option>
            <option value="open-to-mentorship">
              Open to mentorship
            </option>
          </select>
          <button class="button-raised button-circle" title="add-intention">
            {% include "svgs/plus-thin.njk" %}
          </button>
        </div>
        <ul class="mesh-terms">
          {% for item in intentions %}
            <li>
              <span>
                {{ item }}
              </span>
              <button class="button-plain" title="discard-meshterm">
                {% include "svgs/x.njk" %}
              </button>
            </li>
          {% endfor %}
        </ul>
      </fieldset>
    </form>
  </section>
  <section id="user-posts" class="posts tab-section">
    <h3>Posts</h3>
    <div class="align-horizontal">
      <button class="button-raised active">Research projects</button>
      <button class="button-raised">Internships</button>
      <button class="button-raised">Open questions</button>
    </div>
    {% include "network-search-options.njk" %}
    <ul class="horizontal-carousel">
      {% set listName = "user-posts" %}
      {%- for card in collections.opportunity -%}
        {% if name == card.data.name %}
          <li>
            {% set layout = card.data.layoutCard or "default" %}
            {% include "cards/" + layout + ".njk" %}
          </li>
        {% endif %}
      {%- endfor -%}
    </ul>
  </section>
  <section id="my-network" class="my-network tab-section">
    <h3>My network</h3>
    <menu class="align-horizontal">
      <li>
        <button class="button-raised">colleagues</button>
      </li>
      <li>
        <button class="button-raised">
          Network view
          {% include "svgs/tree.njk" %}
        </button>
      </li>
    </menu>
    {% include "network-search-options.njk" %}
    <section>
      <h4>Pending Matches (3)</h4>
      <ul class="network-grid">
        {%- for card in collections.colleague -%}
          <li>
            <a class="button-plain" href="{{ card.url | url }}">
              <figure>
                <img
                  class="image-circle"
                  src="{{ card.data.image | url }}"
                  alt="{{ card.data.name }}"
                >
                <figcaption>{{ card.data.name }}</figcaption>
              </figure>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      <button>
        Remove colleagues
        {% include "svgs/trashcan.njk" %}
      </button>
    </section>
  </section>
  <nav class="profile-tabs">
    <menu>
      <li>
        <a href="#about-user" class="button-tab button-plain" id="about-user">
          About user
        </a>
      </li>
      <li>
        <a href="#user-posts" class="button-tab button-plain" id="user-posts">
          User posts
        </a>
      </li>
      <li>
        <a href="#my-network" class="button-tab button-plain" id="my-network">
          My network
        </a>
      </li>
    </menu>
  </nav>
</main>
