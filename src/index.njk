---
title: Pediaconnect
layout: "base.njk"

---
<section class="rainbow-nav">
  <h2>Welcome back Jane!</h2>
  <nav>
    <ul>
      <li>
        <a class="colleagues button-raised" href="{{'/colleagues' | url}}"
        >Find colleagues</a>
      </li>
      <li>
        <a class="opportunities button-raised" href="{{'/opportunities' | url}}"
        >Browse Opportunities</a>
      </li>
      <li>
        <a
          class="events-and-conventions button-raised"
          href="{{'/events' | url}}"
        >Events & conventions</a>
      </li>
    </ul>
  </nav>
</section>
<section class="recommended">
  <h2>Recommend for you</h2>
  <p>Projects, questions and colleagues selected based on your preferences</p>
  <div class="section-header">
    <select name="recommended-filter" id="recommended-filter">
      <option value="show-all-content">Show all content</option>
      <option value="colleagues">Colleagues</option>
      <option value="opportunities">Opportunities</option>
      <option value="open-questions">Open questions</option>
      <option value="events">Events</option>
    </select>
    <button
      onclick="alert = 'Implementation missing'"
      popovertarget="refresh-popover-menu"
    >
      {% include "svgs/arrow-spiral.njk" %}
    </button>
  </div>
  <div popover id="refresh-popover-menu">
    <a href="#">Refresh the suggestion</a>
    <a href="/user/settings.html/#feed-prefrences">Change your preferences</a>
  </div>
  <ul class="horizontal-carousel">
    {%- for card in collections.recommended -%}
      <li>
        {% set layout = card.data.layoutCard or "default" %}
        {% include "cards/" + layout + ".njk" %}
      </li>
    {%- endfor -%}
  </ul>
  <div class="swipe-tip">
    {% include "svgs/hand-swipe.njk" %}
    <p>Swipe left to see more recommendations</p>
  </div>
</section>
<section class="bookmarked">
  <h2>Your booked marked content</h2>
  <div class="section-header">
    <select name="bookmark-filter" id="bookmark-filter">
      <option value="show-all-content">Show all content</option>
      <option value="colleagues">Colleagues</option>
      <option value="opportunities">Opportunities</option>
      <option value="open-questions">Open questions</option>
      <option value="events">Events</option>
    </select>

    <search>
      <button popovertarget="bookmark-search-form">
        {% include "svgs/magnifying-glass.njk" %}
      </button>
      <form action="search" popover id="bookmark-search-form">
        <label for="bookmark-search">Search in bookmarks:</label>
        <input
          type="search"
          id="bookmark-search"
          placeholder="search in bookmarks"
        >
      </form>
    </search>
  </div>
  <ul class="horizontal-carousel">
    {%- for card in collections.bookmarked -%}
      <li>
        {% set layout = card.data.layoutCard or "default" %}
        {% include "cards/" + layout + ".njk" %}
      </li>
    {%- endfor -%}
  </ul>
  <div class="swipe-tip">
    {% include "svgs/hand-swipe.njk" %}
    <p>Swipe left to see more recommendations</p>
  </div>
</section>
