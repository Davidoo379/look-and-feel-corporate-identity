<article class="card-layout-colleageu-combo">
  <a class="card-link" href="{{ card.url | url }}">Open Card</a>
  <img
    class="image-pill-horizontal"
    src="{{ card.data.image | url}}"
    alt="{{ card.data.name }}"
  >
  <blockquote class="{{ card.data.colorPreference }}">
    {{ card.data.quote }}
  </blockquote>
  {% include "cards/card-buttons.njk" %}
  <h3>{{ card.data.name }}</h3>
  <p class="role">{{ card.data.role }}</p>
  <div class="horizontal-scroll subSpecialism">
    <p>
      {% include "svgs/plus-thick.njk" %}
      <span>{{ card.data.specialism }} {{ card.data.subSpecialism }}</span>
    </p>
  </div>
  <div class="horizontal-scroll institute">
    <p>
      {% include "svgs/hospital.njk" %}
      <span>{{ card.data.institute }}</span>
    </p>
  </div>
  <ul class="mesh-terms">
    <li>{{ card.data.intentions[0] }}</li>
    {% if card.data.intention | length > 1 %}
      <li>+{{ card.data.intentions | length -1 }}</li>
    {% endif %}
  </ul>
  <footer class="cardTags">
    <ul class="cardTags">
      {%- for cardTab in card.data.cardTabs -%}
        <li class="{{ cardTab | kabab}}">{{ cardTab }}</li>
      {%- endfor -%}
    </ul>
  </footer>
</article>
