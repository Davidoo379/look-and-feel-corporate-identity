  <h3>{{ card.data.name }}</h3>
  <p>{{ card.data.role }}</p>
  <p>
    {% include "svgs/plus.njk" %}
    <span>{{ card.data.subSpecialism }}</span>
  </p>
  <p>
    {% include "svgs/hospital.njk" %}

    <span class="institute">{{ card.data.institute }}</span>
  </p>
  <ul class="meshTerms">
    {%- for meshTerm in card.data.meshTerms -%}
      <li>{{ meshTerm }}</li>
    {%- endfor -%}
  </ul>
</article>
