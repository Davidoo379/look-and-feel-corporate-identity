<div class="card-buttons">
  <button
    title="bookmark button"
    class="button-plain"
    onclick="alert(`Implementation missing!`)"
  >
    {% include "svgs/bookmark.njk" %}
  </button>
  {% if listName == "recommended" %}
    <button
      title="card options button"
      class="button-plain"
      popovertarget="card-options-{{ listName }}-{{ loop.index }}"
    >
      {% include "svgs/vertical-dots.njk" %}
    </button>
    <div popover id="card-options-{{ listName }}-{{ loop.index }}">
      {% include "cards/card-options.njk" %}
    </div>
  {% endif %}
</div>
