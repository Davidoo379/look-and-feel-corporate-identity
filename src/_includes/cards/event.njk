<article class="event">
  <a href="{{ card.url | url}}">Open Card</a>
  {% include "cards/card-buttons.njk" %}

  <p class="date">
    <time datetime="{{ card.data.time.date }}" class="dateShort">{{
      card.data.time.dateShort
    }}</time>
    <time datetime="{{ card.data.time.date }}" class="weekday">{{
      card.data.time.weekday
    }}</time>
  </p>

  <p class="location">Location: {{ card.data.location }}</p>

  <p class="time">
    Time: <time datetime="{{ card.data.time.start }}" class="startTime">{{
        card.data.time.start
      }}
    </time> - <time datetime="{{ card.data.time.end }}">{{
      card.data.time.end
    }}</time>
  </p>
  <p class="organizer">Organizer: {{ card.data.organizer }}</p>
  <h3 class="title">{{ card.data.cardTabs }}: {{ card.data.title }}</h3>
  <p class="attendees">{{ card.data.attendees }} colleagues plan to attend</p>

  <footer class="cardTags">
    <ul class="cardTags">
      {%- for cardTab in card.data.cardTabs -%}
        <li class="{{ cardTab | kabab}}">{{ cardTab }}</li>
      {%- endfor -%}
    </ul>
  </footer>
</article>
