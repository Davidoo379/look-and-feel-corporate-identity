<form id="research-type" action="http://httpbin.org/post">
  <details open>
    <summary>Research type</summary>
    <label for="clinical">
      <input type="checkbox" name="research-type" id="clinical">
      Clinical
    </label>
    <label for="fundamental">
      <input type="checkbox" name="research-type" id="fundamental">
      Fundamental
    </label>
    <label for="medical">
      <input type="checkbox" name="research-type" id="medical">
      Medical
    </label>
    <button type="reset">
      Clear filters
    </button>
  </details>
</form>
