<main class="colleague-detail">
  <div class="detail-header">
    <h2>{{ salutation }} {{ name }}</h2>
    <button
      class="mutual-button button-raised"
      popovertarget="mutual-interests"
    >
      {% include "svgs/magnet.njk" %}
    </button>
    <div class="mutual-interests" popover id="mutual-interests">
      <section>
        <button class="button-plain" popovertarget="mutual-interests">
          {% include "svgs/x.njk" %}
        </button>
        {% include "svgs/magnet.njk" %}
        <h3>Mutual interest</h3>
        <p>Here's what you have in common</p>
      </section>
      <img
        class="image-circle"
        src='{{ "/assets/images/anthony-martina.png" | url }}'
        alt="mutual"
      >
      <p>You and Anisha share a mutual connection: <em>Anthony Martina</em></p>
      {% include "svgs/board-checkmark.njk" %}
      <p>
        You and Elise both attended the <em>Pediatric Symposium</em> on <time
          datetime="2025-02-20"
        >20 February 2025</time>.
      </p>
    </div>
  </div>
  <div class="detail-block">
    <img
      class="image-pill-vertical-wide"
      src="{{ image | url}}"
      alt="{{ name }}"
    >
    <blockquote class="{{ colorPreference }}">
      {{ quote }}
    </blockquote>
  </div>
  <dl class="info-section">
    <dt>Role:</dt>
    <dd>{{ role }}</dd>
    <dt>Specialism (sub-specialism):</dt>
    <dd>{{ subSpecialism }}</dd>
    <dt>Years of experience:</dt>
    <dd>{{ experience }}</dd>
    <dt>Institution:</dt>
    <dd>{{ institute }}</dd>
    <div class="colleague-ids">
      <a href="linkedin.com">
        {% include "svgs/linkedin.njk" %}
      </a>
      <button
        class="align-horizontal button-raised"
        popovertarget="identifiers"
      >
        {% include "svgs/id-card.njk" %}
        Identifiers
      </button>
      <div popover id="identifiers">
        <p><em>ORCID:</em> {{ orcid }}</p>
        <p><em>BIG registration:</em> {{ big-registration }}</p>
      </div>
    </div>
  </dl>
  <div class="colleague-tabs">
    <menu>
      <li>
        <a href="#biography" class="button-tab button-plain" id="about-user">
          About user
        </a>
      </li>
      <li>
        <a href="#posts" class="button-tab button-plain" id="user-posts">
          User posts
        </a>
      </li>
    </menu>
  </div>
  <section id="biography" class="biography tab-section">
    <h3>Biography</h3>
    <p>
      {{ biography }}
    </p>
    <h3>Mesh terms</h3>
    <ul class="mesh-terms">
      {%- for meshTerm in meshTerms -%}
        <li>{{ meshTerm }}</li>
      {%- endfor -%}
    </ul>
    <h3>Intentions</h3>
    <ul class="mesh-terms">
      {%- for intention in intentions -%}
        <li>{{ intention }}</li>
      {%- endfor -%}
    </ul>
  </section>
  <section id="posts" class="posts tab-section">
    <h3>Posts</h3>
    <div class="align-horizontal">
      <button class="button-raised active">Research projects</button>
      <button class="button-raised">Internships</button>
      <button class="button-raised">Open questions</button>
    </div>
    <div class="align-right">
      {% include "search.njk" %}
      <button class="button-plain" popovertarget="sort-menu">
        {% include "svgs/arrow-up-and-down.njk" %}
      </button>
      <form popover id="sort-menu" action="http://httpbin.org/post">
        {% include "sorting/sort.njk" %}
      </form>
    </div>
    <ul class="horizontal-carousel">
      {% set listName = "user-posts" %}
      {%- for card in collections.opportunity -%}
        {% if name == card.data.name %}
          <li>
            {% set layout = card.data.layoutCard or "default" %}
            {% include "cards/" + layout + ".njk" %}
          </li>
        {% endif %}
      {%- endfor -%}
    </ul>
  </section>
</main>
