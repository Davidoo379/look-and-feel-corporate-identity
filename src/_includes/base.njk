<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="{{ 'styles/style.css' | url }}">
    <link rel="stylesheet" href="{{ 'styles/header.css' | url }}">
    <link rel="stylesheet" href="{{ 'styles/aside-bar.css' | url }}">
    <link rel="stylesheet" href="{{ 'styles/rainbow-nav.css' | url }}">
    <link rel="stylesheet" href="{{ 'styles/horizontal-carousel.css' | url }}">
    <link rel="stylesheet" href="{{ 'styles/dashboard-sections.css' | url }}">
    <link rel="stylesheet" href="{{ 'styles/cards/cards.css' | url }}">
    <link
      rel="stylesheet"
      href="{{ 'styles/cards/colleague-image.css' | url }}"
    >
    <link
      rel="stylesheet"
      href="{{ 'styles/cards/opportunity.css' | url }}"
    >
    <link
      rel="stylesheet"
      href="https://davidoo379.github.io/look-and-feel-styleguide/styleguide.css"
    >
    <script src="{{ 'scripts/script.js' | url }}" defer></script>
  </head>
  <body>
    <header>
      {% include 'header.njk' %}
    </header>
    <main>
      {{ content | safe }}
    </main>
    <aside>
      {% include "aside-bar.njk" %}
    </aside>
  </body>
</html>
