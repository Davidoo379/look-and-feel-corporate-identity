<fieldset class="filter-fieldset" id="{{ name }}">
  <legend class="hidden">{{ title }}</legend>
  <details open>
    <summary>{{ title }}</summary>
    <div>
      {%- for option in options -%}
        <label>
          <input
            type="checkbox"
            name="{{ name }}"
            class="rounded-checkbox"
          >
          {{ option }}
        </label>
      {%- endfor -%}
    </div>
    <button
      id="clear-fieldset-button"
      type="button"
      class="button-plain"
      commandfor="{{ name }}"
      command="--clear-fieldset"
    >
      Clear filters
    </button>
    <button type="button" class="button-raised">
      {% include "svgs/plus.njk" %}
      see all options
    </button>
  </details>
</fieldset>
